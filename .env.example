# --- Google OAuth (for signing committee members in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Set to your deployed URL in production, e.g. https://ganesha.vercel.app
AUTH_URL=http://localhost:3000

# --- The Google account that owns the spreadsheet and receipts folder ---
# See SETUP.md for how to mint this once.
GOOGLE_REFRESH_TOKEN=

# --- Data locations ---
# The long id between /d/ and /edit in the spreadsheet URL
SHEET_ID=
# The id at the end of the Drive folder URL
DRIVE_RECEIPTS_FOLDER_ID=

# --- Who can change things ---
# Everyone with the link can READ without signing in. Only the addresses below
# can write, and they sign in with Google to do it.
#
#   ADMIN_EMAILS   full access, including deleting records and receipts
#   EDITOR_EMAILS  add and edit records, upload receipts
#
# Comma separated, e.g. ADMIN_EMAILS=you@gmail.com,treasurer@gmail.com
ADMIN_EMAILS=
EDITOR_EMAILS=

# Set to true to also require a Google sign-in just to VIEW the app, in which
# case only the listed admins and editors can get in at all. Leave unset for
# the default of public read access.
REQUIRE_SIGN_IN=

# --- Demo mode (optional, for previewing without Google credentials) ---
# DEMO_MODE=true serves fixture data and is read-only.
# DEMO_ROLE stands in for a signed-in member so the entry forms are visible:
# admin, editor or viewer. Both are ignored unless DEMO_MODE is true.
DEMO_MODE=
DEMO_ROLE=

# --- Display ---
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_LOCALE=en-US
